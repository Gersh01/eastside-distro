# Copy to .env.local for local development (`cp .env.example .env.local`).
# Never commit real secrets. Production values come from AWS Secrets Manager via infra/.

# Postgres from docker-compose.yml (`npm run db:up`). On AWS the app uses PGHOST/PGUSER/... instead.
DATABASE_URL=postgres://eastside:eastside@localhost:5432/eastside

# Public base URL of the site, used in emails and absolute links.
APP_URL=http://localhost:3000

# Email: `log` prints messages to the server console; `ses` sends through Amazon SES.
EMAIL_DRIVER=log
EMAIL_FROM="East Side Distro <no-reply@eastsidedistro.com>"
SALES_INBOX_EMAIL=sales@eastsidedistro.com
# AWS_REGION=us-east-1

# Secret used to hash visitor IP addresses for rate limiting (any long random string locally).
IP_HASH_SECRET=local-development-only-change-me

# Production boot tasks (leave unset locally; ECS sets them to true).
# RUN_MIGRATIONS_ON_BOOT=true
# RUN_CATALOG_SYNC_ON_BOOT=true
