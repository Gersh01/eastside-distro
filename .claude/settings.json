{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run lint *)",
      "Bash(npm run lint:fix *)",
      "Bash(npm run typecheck *)",
      "Bash(npm run format *)",
      "Bash(npm run format:check *)",
      "Bash(npm test *)",
      "Bash(npm run test *)",
      "Bash(npm run check *)",
      "Bash(npm run build *)",
      "Bash(npm run e2e *)",
      "Bash(npm run db:generate *)",
      "Bash(npm run db:migrate *)",
      "Bash(npm run db:seed *)",
      "Bash(npm run db:up *)",
      "Bash(npm run db:setup *)",
      "Bash(npx vitest *)",
      "Bash(npx playwright test *)",
      "Bash(npx tsc --noEmit *)",
      "Bash(npx next typegen *)",
      "Bash(npm --prefix infra test *)",
      "Bash(npm --prefix infra run typecheck *)",
      "Bash(npm --prefix infra run synth *)",
      "Bash(npm --prefix infra run diff *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)"
    ],
    "ask": [
      "Bash(npx cdk deploy *)",
      "Bash(npx cdk destroy *)",
      "Bash(npm --prefix infra run cdk *)",
      "Bash(aws *)",
      "Bash(git push *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.production)",
      "Read(./.env.development)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-files.mjs\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-file.mjs\"",
            "timeout": 30,
            "statusMessage": "Formatting with Prettier"
          }
        ]
      }
    ]
  }
}
